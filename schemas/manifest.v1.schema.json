{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assurance.sprintloop.ai/schemas/manifest.v1.schema.json",
  "title": "SprintLoop exact-candidate manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "changeId", "candidate", "intent", "evidence"],
  "properties": {
    "schemaVersion": { "const": "assurance.sprintloop.dev/manifest/v1" },
    "changeId": { "$ref": "#/$defs/id" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest", "treeDigest", "environment", "producer"],
      "properties": {
        "repository": { "$ref": "#/$defs/repository" },
        "digest": { "$ref": "#/$defs/candidateDigest" },
        "treeDigest": { "$ref": "#/$defs/treeDigest" },
        "environment": { "$ref": "#/$defs/id" },
        "producer": { "$ref": "#/$defs/identity" }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "path", "mediaType", "digest", "subjectDigest"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "type": { "$ref": "#/$defs/id" },
          "path": { "$ref": "#/$defs/relativePath" },
          "mediaType": { "$ref": "#/$defs/mediaType" },
          "digest": { "$ref": "#/$defs/sha256" },
          "subjectDigest": { "$ref": "#/$defs/candidateDigest" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
    "repository": { "type": "string", "maxLength": 2048, "pattern": "^[A-Za-z][A-Za-z0-9+.-]{0,31}:[^\\s\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]{1,2015}$" },
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*[<>\"|?*])(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9¹²³]|[Ll][Pp][Tt][1-9¹²³])(?:[ .]|/|$))(?!.*[. ](?:/|$))(?!.*[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]).+$" },
    "mediaType": { "type": "string", "maxLength": 255, "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]{1,127}/[A-Za-z0-9!#$%&'*+.^_`|~-]{1,127}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "candidateDigest": { "type": "string", "pattern": "^git:(?:sha1:[0-9a-f]{40}|sha256:[0-9a-f]{64})$" },
    "treeDigest": { "type": "string", "pattern": "^git-tree:(?:sha1:[0-9a-f]{40}|sha256:[0-9a-f]{64})$" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principalId", "ownerId", "controlDomain"],
      "properties": {
        "principalId": { "$ref": "#/$defs/id" },
        "ownerId": { "$ref": "#/$defs/id" },
        "controlDomain": { "$ref": "#/$defs/id" }
      }
    }
  }
}
