{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assurance.sprintloop.ai/schemas/policy.v1.schema.json",
  "title": "SprintLoop receiver-owned assurance policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyId", "requiredEvidenceTypes", "allowedVerifierMethods", "separation", "requireNamedHumanAuthority", "requireSignedReceipt", "requireSignedAuthorization", "maxReceiptValiditySeconds", "maxAuthorizationValiditySeconds", "maxClockSkewSeconds", "maxEvidenceBytes", "maxEvidenceItems", "maxTotalEvidenceBytes"],
  "properties": {
    "schemaVersion": { "const": "assurance.sprintloop.dev/policy/v1" },
    "policyId": { "$ref": "#/$defs/id" },
    "requiredEvidenceTypes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "allowedVerifierMethods": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["deterministic", "hybrid"] } },
    "separation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producerVerifier", "verifierAuthority", "producerAuthority"],
      "properties": {
        "producerVerifier": { "$ref": "#/$defs/separation" },
        "verifierAuthority": { "$ref": "#/$defs/separation" },
        "producerAuthority": { "$ref": "#/$defs/separation" }
      }
    },
    "requireNamedHumanAuthority": { "type": "boolean" },
    "requireSignedReceipt": { "type": "boolean" },
    "requireSignedAuthorization": { "type": "boolean" },
    "maxReceiptValiditySeconds": { "type": "integer", "minimum": 60 },
    "maxAuthorizationValiditySeconds": { "type": "integer", "minimum": 60 },
    "maxClockSkewSeconds": { "type": "integer", "minimum": 0 },
    "maxEvidenceBytes": { "type": "integer", "minimum": 1 },
    "maxEvidenceItems": { "type": "integer", "minimum": 1 },
    "maxTotalEvidenceBytes": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
    "separation": { "enum": ["none", "principal", "owner", "control-domain"] }
  }
}
