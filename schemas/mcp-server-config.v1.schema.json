{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assurance.sprintloop.ai/schemas/mcp-server-config.v1.schema.json",
  "title": "SprintLoop Assurance MCP server configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "roots"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "schemaVersion": {
      "const": "assurance.sprintloop.dev/mcp-server-config/v1"
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "kind": {
            "enum": [
              "bundle",
              "receiver",
              "dossier"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxMessageBytes": {
          "type": "integer",
          "minimum": 32768,
          "maximum": 4194304
        },
        "maxJsonBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16777216
        },
        "maxDossierBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 134217728
        },
        "maxToolCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    }
  }
}
