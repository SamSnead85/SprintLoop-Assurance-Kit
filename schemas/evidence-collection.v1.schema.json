{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assurance.sprintloop.ai/schemas/evidence-collection.v1.schema.json",
  "title": "SprintLoop Assurance evidence collection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pathBase", "evidence", "totals"],
  "properties": {
    "schemaVersion": { "const": "assurance.sprintloop.dev/evidence-collection/v1" },
    "pathBase": {
      "anyOf": [
        { "const": "." },
        { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*[<>\"|?*])(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9¹²³]|[Ll][Pp][Tt][1-9¹²³])(?:[ .]|/|$))(?!.*[. ](?:/|$))(?!.*[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]).+$" }
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "path", "mediaType", "digest", "sizeBytes", "format", "formatVersion", "inspectionLevel", "claimsVerified", "summary"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
          "type": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
          "path": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*[<>\"|?*])(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9¹²³]|[Ll][Pp][Tt][1-9¹²³])(?:[ .]|/|$))(?!.*[. ](?:/|$))(?!.*[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]).+$" },
          "mediaType": { "type": "string", "maxLength": 255, "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]{1,127}/[A-Za-z0-9!#$%&'*+.^_`|~-]{1,127}$" },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "sizeBytes": { "type": "integer", "minimum": 0, "maximum": 67108864 },
          "format": { "enum": ["junit", "sarif", "spdx", "cyclonedx", "in-toto", "sigstore"] },
          "formatVersion": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+$" },
          "inspectionLevel": { "enum": ["STRUCTURE_FULL", "ENVELOPE_ONLY"] },
          "claimsVerified": { "const": false },
          "summary": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 16,
            "additionalProperties": {
              "anyOf": [
                { "type": "integer", "minimum": 0, "maximum": 1000000 },
                { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._-]+$" }
              ]
            }
          }
        }
      }
    },
    "manifestEvidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "path", "mediaType", "digest", "subjectDigest"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
          "type": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
          "path": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*[<>\"|?*])(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9¹²³]|[Ll][Pp][Tt][1-9¹²³])(?:[ .]|/|$))(?!.*[. ](?:/|$))(?!.*[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]).+$" },
          "mediaType": { "type": "string", "maxLength": 255, "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]{1,127}/[A-Za-z0-9!#$%&'*+.^_`|~-]{1,127}$" },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "subjectDigest": { "type": "string", "pattern": "^git:(?:sha1:[0-9a-f]{40}|sha256:[0-9a-f]{64})$" }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemCount", "byteCount", "structureFullCount", "envelopeOnlyCount"],
      "properties": {
        "itemCount": { "type": "integer", "minimum": 1, "maximum": 256 },
        "byteCount": { "type": "integer", "minimum": 0, "maximum": 268435456 },
        "structureFullCount": { "type": "integer", "minimum": 0, "maximum": 256 },
        "envelopeOnlyCount": { "type": "integer", "minimum": 0, "maximum": 256 }
      }
    }
  }
}
