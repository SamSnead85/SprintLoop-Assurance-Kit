{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assurance.sprintloop.ai/schemas/doctor-result.v1.schema.json",
  "title": "SprintLoop Assurance setup doctor result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kitVersion", "mode", "status", "summary", "checks", "securityBoundary"],
  "properties": {
    "schemaVersion": { "const": "assurance.sprintloop.dev/doctor-result/v1" },
    "kitVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "mode": { "const": "READ_ONLY_OFFLINE" },
    "status": { "enum": ["pass", "warn", "error"] },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "warn", "error", "total"],
      "properties": {
        "pass": { "type": "integer", "minimum": 0, "maximum": 8 },
        "warn": { "type": "integer", "minimum": 0, "maximum": 8 },
        "error": { "type": "integer", "minimum": 0, "maximum": 8 },
        "total": { "type": "integer", "minimum": 1, "maximum": 8 }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "code", "message", "data"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9.]{0,127}$" },
          "status": { "enum": ["pass", "warn", "error"] },
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
          "message": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+$" },
          "data": {
            "type": "object",
            "maxProperties": 16,
            "additionalProperties": {
              "anyOf": [
                { "type": "string", "maxLength": 4096, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$" },
                { "type": "integer" },
                { "type": "boolean" },
                { "type": "null" },
                { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 128 } }
              ]
            }
          }
        }
      }
    },
    "securityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["networkAccess", "credentialAccess", "filesystemWrites", "sourceControlWrites"],
      "properties": {
        "networkAccess": { "const": false },
        "credentialAccess": { "const": false },
        "filesystemWrites": { "const": false },
        "sourceControlWrites": { "const": false }
      }
    }
  }
}
